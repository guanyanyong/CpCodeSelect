<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <!-- 启动的窗体名字 Form1 大小单双 龙虎逻辑
      Kill3 代表的是启动杀3码的统计逻辑
    -->
    <!--<add key="SetUpForm" value="Form1"/>-->

    <add key="SetUpForm" value="Kill3"/>

    <add key="Kill3NeedZhongCount" value="2"/>
  </appSettings>
</configuration>