	*/
	//点击编辑
	TracePrint "点击编辑"
	返回值 = LibE.小猫.鼠标_左键单击(662, 232, 1)	
	Delay 500
	TracePrint "点击号码"
	返回值 = LibE.小猫.鼠标_左键单击(854,426, 1)	
