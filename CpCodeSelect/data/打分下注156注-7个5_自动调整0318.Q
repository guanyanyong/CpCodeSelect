Do
	返回值 = 窗口调整0()
    返回值 = 处理挂机程序()
    Delay 3500
    //退出循环
Loop
Function 处理挂机程序
    返回值=第一步读取文件并判断是否有新号()
    //返回值 = 第五步判断当前第几期()
End Function
Function 第一步读取文件并判断是否有新号()
    文件内容 = Plugin.File.ReadFileEx(文件路径)
    //TracePrint 文件内容
    //TracePrint "--------------"
    第一行数字1 = ""
    第一行数字2= ""
    行数组 = Split(文件内容, "|")
    期号数组 = array()
    开奖号数组 = array()
    //只获取第一行操作
    //时间戳输出("当前操作不是第一次")
    行内容 = Trim(行数组(0))
    If 行内容 <> "" Then 
        // 按Tab分割（Tab符用ASCII码表示）
        数字1 = Left(行内容, 12)
        数字2 = Right(行内容,5)        	
        返回值 = 判断是否有新号(数字1, 数字2)
        Delay 150
        //TracePrint "不是第一次 解析单行解析结果：数字1=" & 数字1 & ", 数字2=" & 数字2
    End If   
End Function
Function 判断是否有新号(数字1, 数字2)
    //激活添加开奖窗口	
    //Call Plugin.Window.Active(添加开奖窗口)
    //返回值 = 添加开奖窗口激活与调整()
    
    If 前一期数字1 <> 数字1 Then 
        时间戳输出( "前一期期号:"&前一期数字1&"前一期开奖号:"&前一期数字1&"#####当前期号:"&数字1&" 开奖号:"&数字2)
        前一期数字1 = 数字1
        前一期数字2 = 数字2
        //第一期 只是获取前3位号码 不做处理
        If 是否第一期 = 1 Then 
            是否第一期 = 0
            //时间戳输出("当前是第一期 不做处理,等待下期处理")
        Else 
            //时间戳输出("当前获取到的号码是 当前期号码1:" & 当前期号码1 & ",当前期号码2:" & 当前期号码2 & ",当前期号码3:" & 当前期号码3)
            //时间戳输出("上一期的号码是:前一期号码1:" & 前一期号码1 & ",前一期号码2:" & 前一期号码2 & ",前一期号码3:" & 前一期号码3)
            TracePrint "******************执行操作**********************"
            返回值 = 有新开奖号执行程序()
        End If
        Delay 1500
    Else 
        //时间戳输出("没有最新号码 当前期号是:"&前一期数字1 &" 开奖号码是:"&前一期数字2)
    End If
End Function

Function 有新开奖号执行程序()
	//时间戳输出 ("开始执行【有开奖号更新条件】")
	日志输出("开始执行【有开奖号更新条件】")
    返回值 = 窗口调整0()
    返回值 = 投注程序执行()
End Function

Function 投注程序执行()
    
	返回值 = 积分与倍率窗口激活与调整()
    Delay 150
    //TracePrint "等待8秒后判断是否能够执行"
    
	日志输出("等待8秒后判断是否能够执行")
	TracePrint "等待8秒后判断是否能够执行"
    Delay 8000
    //点击窗口空白地方1次     
    返回值 = LibE.小猫.鼠标_左键单击(1832,711, 1)
    Delay 150
    
    返回值 = LibE.小猫.鼠标_左键单击(1832,711, 1)
    Delay 150
    
    //点击【查看当前156码】复制150码 2次
    返回值 = LibE.小猫.鼠标_左键单击(1822,802, 1)
    Delay 150    
    返回值 = LibE.小猫.鼠标_左键单击(1822,802,1)	
    Delay 500
    
    
    //识别投注倍率
    Call Plugin.Pic.PrintScreen(1556,676,1654,706, "C:\Image\识别投注倍数.bmp")
	Delay 500
	识别投注倍数 = Plugin.Xiaomao.bdsbwzsz("C:\Image\识别投注倍数.bmp")
	TracePrint "识别投注倍数=" & 识别投注倍数
	
	投注倍数字符串 = Plugin.Xiaomao.wbqsz(识别投注倍数)
	//TracePrint "投注倍数=" & 投注倍数字符串	
	日志输出("投注倍数=" & 投注倍数字符串)
    投注倍数 = Clng(投注倍数字符串)
    Delay 200
    If (投注倍数 > 0) Then 
    	恒盛娱乐挂机执行 (1)
    	
    	//执行完成后 再次激活积分与倍率窗口
    	//点击空白的地方 
    	返回值 = LibE.小猫.鼠标_左键单击(1832,711,1)	
    	返回值 = LibE.小猫.鼠标_左键单击(1832,711,1)	
    End If
    
End Function

