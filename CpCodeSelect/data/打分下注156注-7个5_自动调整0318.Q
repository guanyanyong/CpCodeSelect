Function 恒盛挂机关闭自动投注(期号)
	TracePrint "点击 1-自动投注-关闭自动投注"
	//点击 1-自动投注
	返回值 = LibE.小猫.鼠标_右键单击(292, 197, 1)
	返回值 = LibE.小猫.鼠标_左键单击(292, 197, 1)
	投注状态 =  "C:\Image\投注状态"&期号&".bmp"
	Call Plugin.Pic.PrintScreen(805,226,908,308, 投注状态)
	Delay 500
	投注状态 = Plugin.Xiaomao.bdsbwzsz(投注状态)
	//TracePrint "投注状态=" & 投注状态
	
	日志输出 ("投注状态=" & 投注状态)
	投注状态1 = Left(投注状态, 6)
	Delay 200
	If 投注状态1 = "开启自动投注" Then 
		
		日志输出("当前需要开启状态,先清空")
	 	TracePrint "当前需要开启状态,先清空"
	 	//点击清空 
		返回值 = LibE.小猫.鼠标_左键单击(843,364, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1012,575, 1)
	ElseIf 投注状态1 = "关闭自动投注" Then
		TracePrint "当前需要关闭,并清空"
		日志输出("当前需要关闭,先清空")
		//点击关闭 
		返回值 = LibE.小猫.鼠标_左键单击(854, 268, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1333, 754, 1)
		
		//点击清空 
		返回值 = LibE.小猫.鼠标_左键单击(843,364, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1012, 575, 1)
	Else 
		TracePrint "当前状态既不是开启也不是关闭 当前状态为:" & 投注状态
		日志输出("当前状态既不是开启也不是关闭 当前状态为:" & 投注状态)		
	End If
End Function

Function 恒盛挂机开启自动投注(期号)
	TracePrint "点击 1-自动投注-开启自动投注"
	//点击 1-自动投注
	返回值 = LibE.小猫.鼠标_右键单击(292, 197, 1)
	返回值 = LibE.小猫.鼠标_左键单击(292, 197, 1)
	投注状态 =  "C:\Image\投注状态"&期号&".bmp"
	Delay 1000
	Call Plugin.Pic.PrintScreen(805,226,908,308,投注状态)
	Delay 500
	投注状态 = Plugin.Xiaomao.bdsbwzsz(投注状态)
	TracePrint "投注状态=" & 投注状态
	
	
	
	If 投注状态 = "开启自动投注" Then 
	
	 	TracePrint "当前是需要开启状态 先清空再 设置开启"
		//点击清空 
		返回值 = LibE.小猫.鼠标_左键单击(843,364, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1012, 575, 1)
		Delay 500
		//点击开启
		返回值 = LibE.小猫.鼠标_左键单击(855, 268, 1)
		Delay 200
	ElseIf 投注状态 = "关闭自动投注" Then
		TracePrint "当前已是开启状态,并清空"
		//点击关闭 
		返回值 = LibE.小猫.鼠标_左键单击(854, 268, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1333, 754, 1)
		
		//点击清空 
		返回值 = LibE.小猫.鼠标_左键单击(843,364, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1012,575, 1)
		
	End If
End Function



Function 恒盛挂机开启自动投注与设置倍率(期号)
	TracePrint "点击 1-自动投注-开启自动投注"
	//1点击 1-自动投注
	返回值 = LibE.小猫.鼠标_右键单击(292, 197, 1)
	返回值 = LibE.小猫.鼠标_左键单击(292, 197, 1)
	投注状态路径 =  "C:\Image\投注状态"&期号&".bmp"
	Delay 1000
	
	//2 先设置方案倍数
	
	//设置投注倍数
	//点击系数 
	返回值 = LibE.小猫.鼠标_左键单击(481,432, 1)
	Delay 200
	
	//循环执行删除操作 清空之前的倍数
	For 7
        KeyPress "BackSpace", 1
        Delay 100
    Next
	Delay 500
	
	//设置倍数 
	返回值 = LibE.小猫.输入文字(投注倍数)
    Delay 300
    
	
	//3 点击开启	
	Call Plugin.Pic.PrintScreen(805,226,908,308,投注状态路径)
	Delay 500
	投注状态 = Plugin.Xiaomao.bdsbwzsz(投注状态路径)
	//TracePrint "投注状态=" & 投注状态
	日志输出("投注状态=" & 投注状态)
	
	If 投注状态= "开启自动投注" Then 
	 	//TracePrint "当前是需要开启状态 设置开启"
		
		日志输出("当前是需要开启状态 点击开启")
		
		//先点击自动投注
		返回值 = LibE.小猫.鼠标_右键单击(292, 197, 1)
		Delay 200
		
		
		//点击开启前先点击清空 
		返回值 = LibE.小猫.鼠标_左键单击(843,364, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1012, 575, 1)
		Delay 200
		
		//点击开启
		返回值 = LibE.小猫.鼠标_左键单击(855,266, 1)
		Delay 200
	ElseIf 投注状态 = "关闭自动投注" Then
		//TracePrint "当前已是开启状态,并清空"
		
		日志输出("当前已是开启状态, 点击关闭")
		//先点击自动投注
		返回值 = LibE.小猫.鼠标_右键单击(292, 197, 1)
		Delay 500
		//点击关闭 
		返回值 = LibE.小猫.鼠标_左键单击(854, 268, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1012,572, 1)
		/* 目前不做清空操作
		//点击清空 
		返回值 = LibE.小猫.鼠标_左键单击(843,364, 1)
		Delay 200
		//点击关闭的确定 todo 做图片识别然后点击
		返回值 = LibE.小猫.鼠标_左键单击(1336,751, 1)
		*/
	End If
	
	
End Function

Function 积分与倍率窗口激活与调整()
	count = 0
    For i = 0 To 2
		Call Plugin.Window.Active(积分与倍率窗口)
		Delay 150
		//第2次点击156注窗口
