//----------------------------------下面是日志---------------------------------------------------------------------
// 修正版：声明Windows API函数 - 明确参数类型为 Long
Declare Function SendMessage Lib "user32" Alias "SendMessageA" (ByVal hwnd As Long, ByVal wMsg As Long, ByVal wParam As Long, ByVal lParam As Long) As Long
// 定义消息常量，让文本框滚动到指定行
Const EM_LINESCROLL = &hB6

// 全局变量，用作滚动行数
Dim scrollLine
scrollLine = 65535

// 日志输出函数
Function 日志输出(内容)
    ' 1. 将新日志插入到第一行
    内容 = FormatDateTime(now, 0) & "_" & 内容
    If Form1.运行日志.Text = "" Then
        Form1.运行日志.Text = 内容
    Else
        Form1.运行日志.Text = 内容 & vbNewLine & Form1.运行日志.Text
    End If
    
    ' 2. 分割成行数组
    Dim 行数组
    行数组 = Split(Form1.运行日志.Text, vbNewLine)
    
    ' 3. 如果行数超过50，只保留前50行（最新日志在前面）
    If UBound(行数组) + 1 > 50 Then
        Dim 新文本, i
        新文本 = ""
        For i = 0 To 49   ' 取前50行（索引0到49）
            If 新文本 = "" Then
                新文本 = 行数组(i)
            Else
                新文本 = 新文本 & vbNewLine & 行数组(i)
            End If
        Next
        Form1.运行日志.Text = 新文本
    End If
End Function

// 确保在脚本开头或调用日志输出前，界面控件已经创建完毕
// 可以加一个极短的延时，确保窗体完全加载
Delay 100
