    Delay 150
    //第2次点击查看当前350码
    返回值 = LibE.小猫.鼠标_左键单击(1825,797,1)	
    Delay 500
End Function

Function 恒盛娱乐挂机执行(第几次)
	返回值 = 恒盛挂机关闭自动投注(第几次)
	返回值 = 恒盛挂机方案设定期数执行(第几次)
	返回值 = 恒盛挂机开启自动投注与设置倍率(第几次)
	TracePrint "等待3秒后再关闭"
	Delay 3000
	
	返回值 = 恒盛挂机关闭自动投注(第几次)
	//返回值 =  恒盛挂机开启自动投注(第几次)
End Function
