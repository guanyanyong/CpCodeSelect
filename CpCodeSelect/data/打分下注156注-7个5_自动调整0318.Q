		返回值 = 积分与倍率窗口调整()	
		Delay 150
    	Call Plugin.Pic.PrintScreen(1364,674,1442,709, "C:\Image\识别156注评分蹲点打.bmp")
    	结果 = Plugin.Xiaomao.bdsbwzsz("C:\Image\识别156注评分蹲点打.bmp")
    	时间戳输出 ("识别结果=" & 结果)
    	
		日志输出("积分与倍率识别结果=" & 结果)
    	If 结果 = "7个5" Then 
        	Exit For
    	Else 
    		Delay 200
    		TracePrint "积分与倍率窗口激活与调整失败,等待下次尝试 当前i=" & i
    		count=count + 1
    	End If
    Next
    
    If count = 3 or count > 3 Then 
    	//播放音乐 
    	For i=0 to 5
    	返回值 = LibE.小猫.播放音乐("C:\test_game\236.wav",8)
    	Next
    	Delay 500
    	MessageBox "积分与倍率窗口激活与调整失败#########$$$$$$$$$$$超时"
    	
    	EndScript
    End If
	 
	
End Function

