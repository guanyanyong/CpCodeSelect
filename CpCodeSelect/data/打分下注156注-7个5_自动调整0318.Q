//--------------------------下面的是配置文件读取代码---------------------------------


' ==================== 配置文件解析命令库 ====================
' 功能：解析格式为 "键=值;" 的配置文件（每行以分号结尾）
' 作者：按键精灵支持
' 日期：2025-03-09
' 说明：所有函数返回值类型明确，无对象/数组返回

' 全局变量：存储配置键值对
Dim g_keys
Dim g_values
Dim g_count

' 初始化（在加载配置前会自动重置）
Sub InitConfig()
    g_keys = Array()      ' 创建空数组
    g_values = Array()
    g_count = 0
End Sub

' 调用初始化，确保数组可用
Call InitConfig()

' ------------------------------------------------------------
' 函数：加载配置文件
' 参数：文件路径 (String)
' 返回：Boolean - True 成功，False 失败
' ------------------------------------------------------------
Function 加载配置文件(文件路径)
    On Error Resume Next
    加载配置文件 = False
    Call InitConfig()

    Dim 文件内容
    文件内容 = Plugin.File.ReadFileEx(文件路径)
    If 文件内容 = "" Then
        //TracePrint "错误：无法读取文件或文件为空 - " & 文件路径
        Exit Function
    End If

    ' 【新增】输出原始文件内容（前200字符）
    //TracePrint "原始文件内容（前200字符）: " & Left(文件内容, 200)

    ' 按行分割
    Dim 行数组, 一行
    行数组 = Split(文件内容, "\r\n")
    //If UBound(行数组) = 0 Then 行数组 = Split(文件内容, "\r")
    //If UBound(行数组) = 0  Then 行数组 = Split(文件内容, ";")
    If UBound(行数组) = 0  Then 行数组 = Split(文件内容, "|")
    

    ' 【新增】输出行数
    //TracePrint "分割后行数: " & (UBound(行数组) + 1)

    For Each 一行 In 行数组
        一行 = Trim(一行)
        //TracePrint "处理行: [" & 一行 & "]"   ' 输出每一行（用方括号包围，便于观察空格）

        If 一行 <> "" And Left(一行, 1) <> "#" Then
            Dim 等号位置
            等号位置 = InStr(一行, "=")
            If 等号位置 > 0 Then
                Dim 键名, 键值
                键名 = Trim(Left(一行, 等号位置 - 1))
                键值 = Trim(Mid(一行, 等号位置 + 1))
                If Right(键值, 1) = ";" Then 键值 = Trim(Left(键值, Len(键值) - 1))
                If 键名 <> "" Then
                    Redim Preserve g_keys(g_count)
                    Redim Preserve g_values(g_count)
                    g_keys(g_count) = 键名
                    g_values(g_count) = 键值
                    g_count = g_count + 1
                    //TracePrint "已添加: " & 键名 & " = " & 键值
                End If
            Else
                //TracePrint "行中无等号，跳过"
            End If
        Else
            //TracePrint "空行或注释行，跳过"
        End If
    Next

    加载配置文件 = (g_count > 0)
    TracePrint "最终配置数量: " & g_count
End Function

' ------------------------------------------------------------
' 函数：获取配置值
' 参数：键名 (String)
' 返回：String - 对应的值，若不存在返回空字符串 ""
' ------------------------------------------------------------
Function GetConfigValue(键名)
    GetConfigValue = ""      ' 始终返回字符串
    
    If g_count = 0 Then
        TracePrint "警告：配置尚未加载或为空"
        Exit Function
    End If
    
    Dim i
    For i = 0 To g_count - 1
        If g_keys(i) = 键名 Then
            GetConfigValue = g_values(i)
            Exit Function
        End If
    Next
    
    ' 未找到时返回空字符串（不输出警告，避免刷屏，如需调试可取消下一行注释）
    ' TracePrint "未找到键名：" & 键名
End Function

' ------------------------------------------------------------
' 辅助函数：列出所有配置（调试用）
' ------------------------------------------------------------
Function DumpAllConfig()
    If g_count = 0 Then
        DumpAllConfig = "无配置"
        Exit Function
    End If
    
    Dim 结果, i
    结果 = ""
    For i = 0 To g_count - 1
        结果 = 结果 & g_keys(i) & " = " & g_values(i) & vbCrLf
    Next
    DumpAllConfig = 结果
End Function




